[Unit]
Description=Status Overlook sync (reconcile + digests)
Documentation=https://github.com/danreed-rh/status-overlook

[Service]
Type=oneshot
# Prefer: status-overlook install-scheduler
# If ExecStart fails, replace with the output of: command -v status-overlook
ExecStart=status-overlook run
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
