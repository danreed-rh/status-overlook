<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.statusoverlook.sync</string>
  <key>ProgramArguments</key>
  <array>
    <string>/path/to/status-overlook</string>
    <string>run</string>
  </array>
  <key>StartInterval</key>
  <integer>900</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/YOU/Library/Logs/status-overlook/scheduler.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOU/Library/Logs/status-overlook/scheduler.stderr.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/Users/YOU/.local/bin</string>
  </dict>
</dict>
</plist>
